+  private createFoundationBindingIfEligible(
+    piece: PlacedPiece,
+    body: Matter.Body,
+    config: (typeof MATERIAL_CONFIGS)[MaterialType],
+    ground: Matter.Body,
+  ): void {
+    if (
+      piece.isPrebuilt ||
+      piece.attachedAnchorId ||
+      piece.condition === 'BROKEN' ||
+      piece.condition === 'LOST' ||
+      (piece.type !== 'wood_block' &&
+        piece.type !== 'stone_block' &&
+        piece.type !== 'bullseye_block')
+    ) {
+      return;
+    }
+
+    const normalizedAngle = Math.atan2(Math.sin(piece.rotation), Math.cos(piece.rotation));
+    const cardinalAngleError = Math.min(
+      Math.abs(normalizedAngle),
+      Math.abs(Math.abs(normalizedAngle) - Math.PI),
+    );
+    const bottomGap = Math.abs(body.bounds.max.y - WORLD_CONFIG.groundY);
+    if (cardinalAngleError > (3 * Math.PI) / 180 || bottomGap > 2.5) {
+      return;
+    }
+
+    const isStone = piece.type === 'stone_block' || piece.type === 'bullseye_block';
+    const halfSpan = config.width * 0.34;
+    const localY = config.height / 2;
+    const stiffness = isStone ? 0.94 : 0.88;
+    const damping = isStone ? 0.34 : 0.30;
+    const constraints = [-halfSpan, halfSpan].map((localX) => {
+      const pointA = { x: localX, y: localY };
+      const worldPoint = Vec2.add(body.position, Vec2.rotate(pointA, body.angle));
+      return Constraint.create({
+        bodyA: body,
+        pointA,
+        bodyB: ground,
+        pointB: Vec2.sub(worldPoint, ground.position),
+        length: 0,
+        stiffness,
+        damping,
+        render: { visible: false },
+      });
+    });
+
+    const thresholds = DAMAGE_THRESHOLDS[piece.type];
+    this.foundationBindings.set(piece.id, {
+      pieceId: piece.id,
+      constraints,
+      restPosition: { x: piece.position.x, y: piece.position.y },
+      restAngle: piece.rotation,
+      breakDisplacementPx: isStone ? 11 : 8,
+      breakAngleRad: isStone ? 0.24 : 0.18,
+      breakImpulseThreshold: thresholds.crackImpulse * (isStone ? 0.95 : 0.80),
+      state: 'INTACT',
+      failureReason: null,
+    });
+    Composite.add(this.engine.world, constraints);
+    this.syncFoundationBindingDiagnosticsCounts();
+  }
